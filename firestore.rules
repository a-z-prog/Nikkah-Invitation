rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /wedding/{weddingId} {
      allow read: if true;
      allow write: if true;
    }
    match /blessings/{blessingId} {
      allow read: if true;
      allow create: if request.resource.data.author is string && request.resource.data.message is string;
      allow update, delete: if true;
    }
    match /rsvps/{rsvpId} {
      allow read: if true;
      allow create: if request.resource.data.name is string && request.resource.data.phone is string;
      allow update, delete: if true;
    }
  }
}
